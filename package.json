{
  "name": "motion-engine",
  "version": "0.2.0",
  "description": "Multi-track motion engine plugin for TalkingHead 3D avatars",
  "type": "module",
  "main": "src/MotionEngine.js",
  "exports": {
    ".": "./src/MotionEngine.js",
    "./studio": "./src/MotionStudio.js",
    "./overlay": "./src/OverlayManager.js",
    "./motions": "./src/motions.json",
    "./motions-th": "./src/motions_th.json"
  },
  "scripts": {
    "demo": "vite --open",
    "build": "vite build",
    "deploy": "npm run build && npx gh-pages -d dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "talkinghead",
    "avatar",
    "3d",
    "motion",
    "animation",
    "gesture"
  ],
  "license": "MIT",
  "devDependencies": {
    "talkinghead": "github:met4citizen/TalkingHead",
    "gh-pages": "^6.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
