    "fear":         { "aus": { "AU1": 0.6, "AU2": 0.5, "AU4": 0.3, "AU5": 0.7, "AU7": 0.5, "AU20": 0.6, "AU26": 0.4 } },
    "surprise":     { "kind": "beat", "aus": { "AU1": 0.7, "AU2": 0.8, "AU5": 0.8, "AU26": 0.6 }, "envelope": { "in": 180, "hold": 900, "out": 500 } },
    "disgust":      { "aus": { "AU9": 0.8, "AU10": 0.5, "AU15": 0.4, "AU16": 0.3 } },
