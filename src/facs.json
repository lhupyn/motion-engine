{
  "_doc": "FACS layer for MotionEngine. au_map: FACS Action Unit -> ARKit blendshapes (base L/R morphs, verified against the loaded model; never the TH composites mouthSmile/mouthOpen/eyesClosed to avoid double-driving). expressions: emotion -> weighted AU recipe (apex proportions) + optional envelope; final morph = auWeight * recipe * intensity, clamped 0..1. Unilateral AU via _L/_R suffix (e.g. AU12_L). intensity_words map to the FACS A-E baremo (default ~C). aliases resolve free-text emotion words (and common [stage-direction] brackets) to a canonical expression.",

  "au_map": {
    "AU1":  { "browInnerUp": 1 },
    "AU2":  { "browOuterUpLeft": 1, "browOuterUpRight": 1 },
    "AU4":  { "browDownLeft": 1, "browDownRight": 1 },
    "AU5":  { "eyeWideLeft": 1, "eyeWideRight": 1 },
    "AU6":  { "cheekSquintLeft": 1, "cheekSquintRight": 1 },
    "AU7":  { "eyeSquintLeft": 1, "eyeSquintRight": 1 },
    "AU9":  { "noseSneerLeft": 1, "noseSneerRight": 1 },
    "AU10": { "mouthUpperUpLeft": 1, "mouthUpperUpRight": 1 },
    "AU12": { "mouthSmileLeft": 1, "mouthSmileRight": 1 },
    "AU14": { "mouthDimpleLeft": 1, "mouthDimpleRight": 1 },
    "AU15": { "mouthFrownLeft": 1, "mouthFrownRight": 1 },
    "AU16": { "mouthLowerDownLeft": 1, "mouthLowerDownRight": 1 },
    "AU17": { "mouthShrugLower": 1 },
    "AU18": { "mouthPucker": 1 },
    "AU20": { "mouthStretchLeft": 1, "mouthStretchRight": 1 },
    "AU22": { "mouthFunnel": 1 },
    "AU23": { "mouthPressLeft": 1, "mouthPressRight": 1 },
    "AU24": { "mouthPressLeft": 1, "mouthPressRight": 1, "mouthClose": 0.3 },
    "AU25": { "jawOpen": 0.2 },
    "AU26": { "jawOpen": 0.7 },
    "AU28": { "mouthRollLower": 1, "mouthRollUpper": 1 },
    "AU43": { "eyeBlinkLeft": 1, "eyeBlinkRight": 1 }
  },

  "intensity_words": {
    "_default": 0.55,
    "faint": 0.2, "trace": 0.2,
    "slight": 0.35, "mild": 0.35, "subtle": 0.35, "soft": 0.35,
    "moderate": 0.55, "medium": 0.55,
    "strong": 0.75, "marked": 0.75, "pronounced": 0.75,
    "intense": 0.95, "extreme": 0.95, "max": 1.0
  },

  "expressions": {
    "neutral":      { "aus": {} },
    "happy":        { "aus": { "AU6": 0.6, "AU12": 1.0 } },
    "laugh":        { "kind": "beat", "aus": { "AU6": 0.8, "AU12": 1.0, "AU26": 0.35 }, "envelope": { "in": 250, "hold": 1400, "out": 500 } },
    "excited":      { "aus": { "AU5": 0.4, "AU6": 0.6, "AU12": 0.9, "AU26": 0.3 } },
